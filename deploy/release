#!/usr/bin/env python3
import argparse, json, os, re, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SDKS = [
    ("python", ROOT / "python" / "pyproject.toml", ROOT / "python"),
    ("rust", ROOT / "rust" / "Cargo.toml", ROOT / "rust"),
    ("javascript-sdk", ROOT / "node" / "package.json", ROOT / "node"),
]

def sh(*args, check=True, **kwargs):
    kwargs.setdefault("cwd", ROOT)
    return subprocess.run(args, text=True, check=check, **kwargs)

def out(*args):
    return sh(*args, stdout=subprocess.PIPE).stdout.strip()

def version(manifest):
    if manifest.name == "package.json":
        return json.loads(manifest.read_text())["version"]
    return re.search(r'^version = "([^"]+)"', manifest.read_text(), re.M).group(1)

def secret(name):
    return out(
        "aws", "secretsmanager", "get-secret-value",
        "--region", "us-east-2",
        "--secret-id", name,
        "--query", "SecretString",
        "--output", "text",
    )

def changed_since(tag, sdk_root):
    if tag is None:
        return True
    rel_sdk_root = str(sdk_root.relative_to(ROOT))
    rel_deploy = str((sdk_root / "deploy").relative_to(ROOT))
    return sh(
        "git", "diff", "--quiet", f"{tag}..HEAD",
        "--", rel_sdk_root, f":(exclude){rel_deploy}",
        check=False,
    ).returncode != 0

parser = argparse.ArgumentParser()
parser.add_argument("--first", action="store_true")
parser.add_argument("--minor", action="store_true")
parser.add_argument("message")
args = parser.parse_args()

if out("git", "branch", "--show-current") != "main":
    raise SystemExit("deploy/release: must run from main")

sh("git", "add", ".")
if out("git", "status", "--porcelain"):
    sh("git", "commit", "-m", args.message)
    sh("git", "push", "origin", "main")
else:
    print("No source changes to commit")

for name, manifest, sdk_root in SDKS:
    tag = (out("git", "tag", "--list", f"{name}/v*", "--sort=-v:refname").splitlines() or [None])[0]
    changed = changed_since(tag, sdk_root)
    if not changed:
        print(f"Skipping {name}: no changes since {tag}")
        continue

    old = version(manifest)
    cmd = [sys.executable, str(sdk_root / "deploy" / "release")]
    if args.first or tag is None:
        cmd.append("--first")
    if args.minor:
        cmd.append("--minor")

    env = os.environ.copy()
    if name == "python":
        env["UV_PUBLISH_TOKEN"] = secret("package-manager-tokens/python")
    if name == "rust":
        env["CARGO_REGISTRY_TOKEN"] = secret("package-manager-tokens/rust")
    if name == "javascript-sdk":
        env["NODE_AUTH_TOKEN"] = secret("package-manager-tokens/npm")

    print(f"Publishing {name} from {tag or 'no previous tag'}")
    released = sh(*cmd, cwd=sdk_root, env=env, check=False)
    if released.returncode:
        raise SystemExit(f"{name} release stopped. Resolve the message above and run it again.")
    new = version(manifest)
    rel_manifest = str(manifest.relative_to(ROOT))
    if sh("git", "diff", "--quiet", "--", rel_manifest, check=False).returncode:
        sh("git", "add", rel_manifest)
        sh("git", "commit", "-m", f"Release {name} v{new}")
    sh("git", "tag", f"{name}/v{new}")
    print(f"Published {name} {old} -> {new}")

sh("git", "push", "origin", "main", "--tags")
