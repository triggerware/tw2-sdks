#!/usr/bin/env python3
import argparse, re, subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "Cargo.toml"

def read_version():
    return re.search(r'^version = "([^"]+)"', MANIFEST.read_text(), re.M).group(1)

def bump(v):
    _major, minor, patch = map(int, v.split("."))
    if patch >= 9:
        return f"1.{minor + 1}.0"
    return f"1.{minor}.{patch + 1}"

def set_version(old, new):
    MANIFEST.write_text(MANIFEST.read_text().replace(f'version = "{old}"', f'version = "{new}"', 1))

def latest_version():
    tags = subprocess.check_output(
        ["git", "tag", "--list", "rust/v*", "--sort=-v:refname"],
        cwd=ROOT.parent,
        text=True,
    ).splitlines()
    return tags[0].removeprefix("rust/v") if tags else None

p = argparse.ArgumentParser()
p.add_argument("--first", action="store_true")
args = p.parse_args()

old = read_version()
released = latest_version()
if args.first:
    new = old
elif old == released:
    new = bump(old)
elif released and old == bump(released):
    new = old
else:
    raise SystemExit(
        f"Cannot release Rust SDK: manifest version {old} does not follow "
        f"the latest tag rust/v{released}."
    )

if old != new:
    set_version(old, new)
locked = subprocess.run(["cargo", "generate-lockfile"], cwd=ROOT)
if locked.returncode:
    raise SystemExit("Failed to update the Rust SDK lockfile.")
changed = subprocess.run(
    ["git", "diff", "--quiet", "--", "rust/Cargo.toml", "rust/Cargo.lock"],
    cwd=ROOT.parent,
).returncode
if changed:
    subprocess.run(
        ["git", "add", "rust/Cargo.toml", "rust/Cargo.lock"],
        cwd=ROOT.parent,
        check=True,
    )
    subprocess.run(
        ["git", "commit", "-m", f"Release rust v{new}"],
        cwd=ROOT.parent,
        check=True,
    )
published = subprocess.run(["cargo", "publish"], cwd=ROOT)
if published.returncode:
    raise SystemExit("Failed to publish the Rust SDK. Fix the Cargo error above and rerun.")
print(f"Published rust {old} -> {new}")
