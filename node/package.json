{
  "name": "triggerware",
  "version": "1.1.1",
  "description": "Modern TypeScript SDK for Triggerware",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs"
  },
  "dependencies": {
    "tw2-jsonrpc": "^1.0.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
